# Supabase project settings (Project Settings -> API).
# The anon/publishable key is safe to expose only because Row Level Security
# restricts it to inserting contact form submissions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Not used yet. Never prefix a service-role key with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
